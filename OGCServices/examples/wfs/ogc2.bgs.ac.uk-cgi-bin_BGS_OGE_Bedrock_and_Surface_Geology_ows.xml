  <ows:ServiceIdentification>
    <ows:Title>BGS OGE bedrock and surface geology</ows:Title>
    <ows:Abstract>The 1:625k DiGMap data covering the whole of the United Kingdom is available in this OGC WFS service for your personal, non-commercial use only and was being served as a contribution to the OneGeology-Europe initiative, which has now ended; see https://www.europe-geology.eu/project/onegeology-europe/ for details. The contents of this WFS service were not intended for direct use but were transformed by a mediator layer into separate WFS services which provided data in GeoSciML; the mediator is no longer maintained. For information about more of the British Geological Survey's maps that are available digitally please visit https://www.bgs.ac.uk/products/digitalmaps/digmapgb.html.</ows:Abstract>
    <ows:Keywords>
      <ows:Keyword>OneGeology</ows:Keyword>
      <ows:Keyword>MD_LANG@ENG</ows:Keyword>
      <ows:Keyword>MD_DATE@2019-01-22</ows:Keyword>
    </ows:Keywords>
    <ows:ServiceType codeSpace="OGC">WFS</ows:ServiceType>
    <ows:ServiceTypeVersion>2.0.0</ows:ServiceTypeVersion>
    <ows:Fees>none</ows:Fees>
