    {
      "@id": "https://geosas.fr/geoserver/wfs?service=WFS&request=GetCapabilities#layer/sdb:Classes_RUM_1m_Bretagne_UCS",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WFS feature type"
      ],
      "schema:name": "Classes de réservoir en eau utilisable des sols des UCS",
      "schema:identifier": "sdb:Classes_RUM_1m_Bretagne_UCS",
      "schema:description": "Le Réservoir en eau Utilisable Maximal des sols Bretagne a été estimé pour la région Bretagne à partir du Référentiel Régional Pédologique de Bretagne, dans la limite maximale de 1 mètre d’épaisseur du sol. Cette thématisation a été réalisée avec des fonctions de pédotransfert, en suivant la méthode détaillée dans le guide RU aux éditions Arvalis (Bouthier et al., 2022). La représentativité des classes de RUM par UCS, de 0 à 100 %, est cartographiée pour chaque classe : Classe 1 : RUM compris entre 0 et 50 mm Classe 2 : RUM compris entre 50 et 100 mm Classe 3 : RUM compris entre 100 et 150 mm Classe 4 : RUM compris entre 150 et 200 mm Classe 5 : RUM compris entre 200 et 500 mm",
      "schema:keywords": [
        "features",
        "Classes_RUM_1m_Bretagne_UCS"
      ],
