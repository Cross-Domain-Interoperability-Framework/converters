    {
      "@id": "https://geosas.fr/geoserver/wfs?service=WFS&request=GetCapabilities#layer/selune:v_bioc_vegriv_uv_vegriv",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WFS feature type"
      ],
      "schema:name": "Unités de végétation associées aux stations de suivi de la végétation rivulaire - Observatoire Sélune",
      "schema:identifier": "selune:v_bioc_vegriv_uv_vegriv",
      "schema:description": "L'étude de la végétation rivulaire repose sur l'observation des communautés végétales naturelles colonisant spontanément les surfaces nouvellement exposées suite à l’effacement des barrages de Vezins et de La-Roche-Qui-Boit. Le dispositif de suivi des végétations comprend deux approches complémentaires : i) une méthode d'échantillonnage des végétations basée sur la réalisation de relevés floristiques (composition & structure) effectués au sein d’une série de quadrats positionnés le long d’un transect ii) un suivi des Unités de Végétations (UV) observées au sein de la vallée Ce jeu de données concerne spécifiquement le suivi des Unités de Végétations (UV) observées au sein de la vallée enregistrées entre 2021 et 2026.",
      "schema:keywords": [
        "features",
        "v_bioc_vegriv_uv_vegriv"
