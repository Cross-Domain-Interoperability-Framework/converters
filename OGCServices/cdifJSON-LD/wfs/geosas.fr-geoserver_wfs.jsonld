    {
      "@id": "https://geosas.fr/geoserver/wfs?service=WFS&request=GetCapabilities#layer/ore:nzn_parcellaire_1993_2020",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WFS feature type"
      ],
      "schema:name": "Occupation des sols de 1993 à 2020 sur la bassin versant de Naizin",
      "schema:identifier": "ore:nzn_parcellaire_1993_2020",
      "schema:description": "L’occupation des sols caractérise la couverture bio-physique des terres émergées, et sur le site de l'observatoire AgrHyS à Naizin, cette occupation est dominée par l’agriculture avec plus de 90 % de la surface du bassin (ici 12 km2 ont été cartographiés) en culture ou prairie. Les agriculteurs pratiquent des rotations sur leur parcelle, ainsi l’occupation du sol change chaque année, et parfois plusieurs fois dans l’année s’il y a une inter-culture.",
      "schema:keywords": [
        "occupation des sols",
        "ORE AgrHyS"
      ],
