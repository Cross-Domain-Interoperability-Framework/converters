    {
      "@id": "https://geosas.fr/geoserver/wfs?service=WFS&request=GetCapabilities#layer/selune:v_bioc_macroph_eval_macroph",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WFS feature type"
      ],
      "schema:name": "Indices biologiques basés sur les macrophytes - Observatoire Sélune",
      "schema:identifier": "selune:v_bioc_macroph_eval_macroph",
      "schema:description": "Les macrophytes sont un ensemble de plantes aquatiques. Elles se situent à la base de la chaine alimentaire et peuvent fournir un habitat à de nombreuses autres espèces Dans le cadre de l'Observatoire Sélune, les stations sont échantillonnées 1 fois par an pour les stations hors retenues (S0, S1 et S5) et 2 fois par an (printemps/automne) pour les stations néo-lotiques (S2, S3.4, S4.1 et S6). Cet échantillonnage s'appuie le protocole d’échantillonnage des macrophytes et bryophytes suivant la norme NF T90-395 (octobre 2003) qui définit l’IBMR. Les taxa sont prélevés pour être identifiés en laboratoire. Cette couche donne non seulement la valeur de l'indice IBMR et EQR (normé) à une station pour une campagne mais également des informations spécifiques telles que le nombre de taxons global, contributifs, par valeur de coëfficient de sténoécie (1, 2, 3), des éléments de robustesse de l'indice, des informations concernant le coëfficient de sténoécie, et la côte spécifique. Cette couche propose également de nombreux éléments concernant la ou les unités de relevé (1 ou 2), en terme de proportion de type de végétation.",
      "schema:keywords": [
        "features",
        "v_bioc_macroph_eval_macroph"
      ],
      "schema:spatialCoverage": [
        {
          "@type": [
            "schema:Place"
          ],
          "schema:geo": {
            "@type": [
              "schema:GeoShape"
            ],
            "schema:box": "48.562997 -1.293705 48.611903 -0.980036"
          }
        }
      ],
      "schema:relatedLink": [
        {
          "@type": [
            "schema:LinkRole"
          ],
          "schema:linkRelationship": "describedby",
          "schema:target": {
            "@type": [
              "schema:EntryPoint"
            ],
            "schema:url": "https://geosas.fr/geonetwork/srv/fre/catalog.search#/metadata/29cccd5c-fc0e-4131-b58d-5c54e836e50e"
          }
        },
        {
          "@type": [
            "schema:LinkRole"
          ],
