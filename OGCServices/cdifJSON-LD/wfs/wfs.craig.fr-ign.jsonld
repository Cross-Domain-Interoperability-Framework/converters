  "schema:version": "2.0.0",
  "schema:name": "Service de téléchargement (WFS) des données IGN sur Auvergne-Rhône-Alpes: BD Topo/BD Forêt",
  "schema:description": "Ce service de téléchargement (WFS) permet d'accéder depuis un SIG aux données spatiales vectorielles et attributaires de la BD Topo et BD Forêt de l'IGN (millésime 2026) sur la région Auvergne-Rhône-Alpes. Il est conseillé d'utiliser des filtres attributaires ou spatiaux pour limiter le volume de données demandé.",
  "schema:keywords": [
    "IGN",
    "BD TOPO",
    "boundaries",
    "location",
    "transportation",
    "utilitiesCommunication",
    "BD FORET",
    "biota",
    "environment",
    "planningCadastre",
    "OGC:WFS",
    "WFS 1.1.0",
    "WFS 2.0.0",
    "wfs.craig.fr",
    "wfs.craig.fr/ign"
  ],
