    {
      "@id": "https://ids.craig.fr/wxs/public/ows?service=WMS&request=GetCapabilities#layer/VVA_2021_PATRIMOINE_UNESCO",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WMS layer"
      ],
      "schema:name": "CAV - Périmètre de Vichy Grande ville d'eau d'Europe inscrit au Patrimoine Mondial de l'UNESCO - Vichy - 2021",
      "schema:identifier": "VVA_2021_PATRIMOINE_UNESCO",
      "schema:description": "Vichy fait partie des 11 Grandes villes d’eaux d’Europe situées dans sept pays européens, l’ensemble de ces périmètres forment un seul et unique site inscrit au Patrimoine Mondial de l’UNESCO. Ce bien transnational est reconnu comme apportant un témoignage exceptionnel sur le phénomène du thermalisme européen qui a atteint son apogée entre le XVIIIè siècle et les premières décennies du XXè siècle. Les sources, les établissements thermaux, les lieux de promenades, opéras, théâtres, pavillons de musique, gares, parcs, cafés, golfs ou hippodrome… tout ce que l’on conserve aujourd’hui de cette période faste, témoigne de cette valeur immatérielle exceptionnelle.",
      "schema:keywords": [
        "features",
        "VVA_2021_PATRIMOINE_UNESCO"
      ],
      "schema:spatialCoverage": [
