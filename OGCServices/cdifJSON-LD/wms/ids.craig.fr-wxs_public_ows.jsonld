    {
      "@id": "https://ids.craig.fr/wxs/public/ows?service=WMS&request=GetCapabilities#layer/rpp_cantal_v2023_01_24",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WMS layer"
      ],
      "schema:name": "VetAgroSUP - Carte des pédopaysages - Cantal 2023",
      "schema:identifier": "rpp_cantal_v2023_01_24",
      "schema:description": "Un pédopaysage est un ensemble litho-géomorpho-pédologique cohérent. Plusieurs sols sont regroupés de manière hiérarchisée au sein d’un paysage identifié par des caractéristiques homogènes. Cette carte des pédopaysages du département du Cantal (572 600 ha) a été réalisée en 2 phases et 4 équipes de pédologues. La synthèse des 2 phases et les différents résultats obtenus par les équipes ont été corrigés, harmonisés et agrégés par VetAgro-Sup. Une notice explicative au format pdf accompagne la donnée.",
      "schema:keywords": [
        "features",
        "rpp_cantal_v2023_01_24"
      ],
