    {
      "@id": "https://ids.craig.fr/wxs/public/ows?service=WMS&request=GetCapabilities#layer/CRAIG_2013_MNTLiDAR_Clermont_TA_L93",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WMS layer"
      ],
      "schema:name": "CRAIG - Modéle Numérique de Terrain (MNT) - Agglomération de Clermont-Ferrand",
      "schema:identifier": "CRAIG_2013_MNTLiDAR_Clermont_TA_L93",
      "schema:description": "Le produit Modéle Numérique de Terrain (MNT) - Clermont-Communauté décrit la forme du terrain du territoire de l'agglomération de Clermont-Ferrand. Le MNT a été réalisé en 2013 par le groupement d'entreprises APEI-SINTEGRA pour le CRAIG. L'altimétrie a été obtenue par un lever LIDAR. Le MNT est une grille régulière générée par interpolation à partir des points « sol ». En cas d’absence de points « sol » (rivière, maison…) la grille est calculée à partir des points sol les plus proches. Les données sont téléchargeables en Open Data depuis le catalogue au format ASCII. Projet co-financé par l'Union européenne - fonds européen de développement régional FEDER - L'Europe s'engage en Auvergne",
      "schema:keywords": [
        "features",
        "CRAIG_2013_MNTLiDAR_Clermont_TA_L93"
      ],
      "schema:spatialCoverage": [
