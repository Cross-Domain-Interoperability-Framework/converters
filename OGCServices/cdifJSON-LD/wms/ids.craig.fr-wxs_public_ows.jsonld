    {
      "@id": "https://ids.craig.fr/wxs/public/ows?service=WMS&request=GetCapabilities#layer/CARTE_SOL_DOMINANT_63",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WMS layer"
      ],
      "schema:name": "VetAgroSUP - Carte des sols dominants - Puy-de-Dôme - 2019",
      "schema:identifier": "CARTE_SOL_DOMINANT_63",
      "schema:description": "Un pédopaysage est un ensemble litho-géomorpho-pédologique cohérent. Plusieurs sols sont regroupés de manière hiérarchisée au sein d’un paysage identifié par des caractéristiques homogènes. Cette carte des pédopaysages du département du Puy-de-Dôme a été réalisée en 2 phases et 4 équipes de pédologues. La synthèse des 2 phases et les différents résultats obtenus par les équipes ont été corrigés, harmonisés et agrégés par VetAgro-Sup. Une notice explicative au format pdf accompagne la donnée.",
      "schema:keywords": [
        "features",
        "CARTE_SOL_DOMINANT_63"
      ],
      "schema:spatialCoverage": [
        {
          "@type": [
            "schema:Place"
          ],
          "schema:geo": {
            "@type": [
              "schema:GeoShape"
            ],
            "schema:box": "45.282759 2.383271 46.256654 3.999133"
          }
        }
      ],
      "schema:relatedLink": [
        {
