    {
      "@id": "https://data.geopf.fr/wms-r?service=WMS&request=GetCapabilities#layer/IGNF_PLAN-IGN-HD",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WMS layer"
      ],
      "schema:name": "Plan IGN HD",
      "schema:identifier": "IGNF_PLAN-IGN-HD",
      "schema:description": "Le plan IGN HD cartographie les paysages à grande échelle de façon tres détaillée en intégrant au fonds de carte la richesse des informations issus des données LiDAR HD et d’occupation du sol issu des données COSIA. Cette version est dédiée à la mise en avant des éléments du paysages au dessus du sol, comme la végétation, les bâtiments et leurs ombres portées.",
      "schema:keywords": [
        "plan ign",
        "sursol",
        "mns",
