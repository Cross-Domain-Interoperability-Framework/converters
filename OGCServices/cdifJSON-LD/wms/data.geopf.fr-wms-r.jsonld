    {
      "@id": "https://data.geopf.fr/wms-r?service=WMS&request=GetCapabilities#layer/INRAE_CARTE-SOLS",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WMS layer"
      ],
      "schema:name": "Les sols dominants de France métropolitaine – Carte harmonisée",
      "schema:identifier": "INRAE_CARTE-SOLS",
      "schema:description": "Les Référentiels Régionaux Pédologiques (RRP) sont une représentation des sols à l’échelle du 1/250 000, réalisés par département ou par région dans le cadre du programme Inventaire, Gestion et Conservation des Sols (IGCS) coordonné par le Groupement d’intérêt scientifique sur les Sols ou Gis Sol. Il s’agit de l’information pédologique cartographique la plus précise actuellement disponible sur la totalité du territoire de France métropolitaine. Cartographier les sols à l’échelle du 1/250 000 consiste à délimiter la portion de la couverture pédologique qui présente des caractéristiques communes en termes de paysage et de répartition des sols. Ces ensembles cohérents sont alors appelés Unités Cartographiques de Sols (UCS). A cette échelle de représentation, chacune des plages cartographiques ou UCS est caractérisée par un ou plusieurs types de sol différents, nommés Unités Typologiques de Sol (UTS). Le pourcentage surfacique de chaque UTS a été estimé au sein de chaque UCS, et les noms de sols ont été décrits suivant le Référentiel Pédologique français (Baize et al., 2008 - [https://www.afes.fr/referentiel-pedologique](https://www.afes.fr/referentiel-pedologique)). Les RRP sont constitués d’une carte associée à une base de données sémantiques décrivant de manière exhaustive les UCS et les UTS du territoire concerné. Cette base de données est structurée selon un format national : Donesol. La présente carte est issue de l’harmonisation de l’ensemble des RRP au niveau des limites administratives pour aboutir au RRP harmonisé national par l’unité Info&amp;Sols d’INRAE. Les données par territoire (régional ou départemental) peuvent être obtenues auprès des gestionnaires locaux des RRP.",
      "schema:keywords": [
        "UCS",
        "sols dominants",
        "Référentiels Régionaux Pédologiques",
        "RRP",
        "sol",
        "environment",
        "Info&Sols",
        "inventaire gestion et conservation des sols",
        "UTS",
        "GER",
        "farming",
        "INRAE",
        "pédologie",
        "geoscientificInformation"
      ],
      "schema:spatialCoverage": [
        {
          "@type": [
            "schema:Place"
          ],
          "schema:geo": {
            "@type": [
              "schema:GeoShape"
            ],
            "schema:box": "42.332922 -5.141256 51.089151 8.232496"
          }
        }
      ],
      "schema:relatedLink": [
        {
          "@type": [
            "schema:LinkRole"
          ],
          "schema:linkRelationship": "describedby",
          "schema:target": {
            "@type": [
              "schema:EntryPoint"
            ],
            "schema:url": "https://data.geopf.fr/csw?REQUEST=GetRecordById&SERVICE=CSW&VERSION=2.0.2&OUTPUTSCHEMA=http%3A%2F%2Fwww.isotc211.org%2F2005%2Fgmd&elementSetName=full&ID=osfd95caa37-436b-431c-9391-643164f010bb"
          }
        },
