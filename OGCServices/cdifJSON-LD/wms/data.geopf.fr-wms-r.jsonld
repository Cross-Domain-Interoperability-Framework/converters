    {
      "@id": "https://data.geopf.fr/wms-r?service=WMS&request=GetCapabilities#layer/ORTHOIMAGERY.ORTHOPHOTOS.1950-1965",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WMS layer"
      ],
      "schema:name": "Photographies aériennes historiques 1950-1965",
      "schema:identifier": "ORTHOIMAGERY.ORTHOPHOTOS.1950-1965",
      "schema:description": "Couverture en photographies aériennes de la France des années 1950-1965. Cette couverture a été réalisée à partir des photographies aériennes historiques numérisées par l'IGN. Elle est disponible sur la France métropolitaine, les départements et régions d'Outre-Mer (la Guyane n'est que partiellement couverte) et les collectivités d'Outre-Mer sauf la Polynésie française. Les photographies sont orthorectifiées, c'est-à-dire corrigées des déformations dues à la prise de vue et au relief du terrain, et assemblées pour fournir une visualisation continue superposable avec le Référentiel à Grande Echelle (RGE®) ou les cartes.",
      "schema:keywords": [
        "Orthophotographies"
      ],
      "schema:spatialCoverage": [
