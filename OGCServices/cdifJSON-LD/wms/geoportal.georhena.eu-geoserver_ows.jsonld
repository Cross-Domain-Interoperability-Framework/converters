    {
      "@id": "https://geoportal.georhena.eu/geoserver/ows?service=WMS&request=GetCapabilities#layer/boundaries:zone_interreg_RS",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WMS layer"
      ],
      "schema:name": "Zonage Interreg pour la programmation 2021-2027",
      "schema:identifier": "boundaries:zone_interreg_RS",
      "schema:description": "La région du Rhin supérieur s’étend sur 350 kilomètres le long du Rhin, à cheval entre France, Allemagne et Suisse. Il est constitué de quatre territoires : l’Alsace, le Sud et Sud Ouest du Palatinat, une partie du Pays de Bade et les cinq cantons de Suisse du Nord-Ouest. Pour la période 2021-2027, la zone de programmation Interreg Rhin Supérieur évolue par rapport à 2014-2020. En effet, la circonscription de Pirmasens au Nord-Ouest complète désormais le Sud-Palatinat du côté allemand. Un projet est éligible s’il implique au moins deux partenaires de part et d’autre de la frontière, dans deux des trois pays composant le territoire. Le siège de l’organisation qui porte le projet doit se situer dans cette zone de programmation.",
      "schema:keywords": [
        "features",
        "Zone_interreg_RS"
      ],
