  "schema:dataset": [
    {
      "@id": "https://geoportal.georhena.eu/geoserver/ows?service=WMS&request=GetCapabilities#layer/environment:AOI_dem_rhin",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WMS layer"
      ],
      "schema:name": "Modèle numérique du fond du Rhin / Digitales Geländemodell des Flussbettes des Rheins",
      "schema:identifier": "environment:AOI_dem_rhin",
      "schema:description": "Cette donnée propose les altitudes absolues du fond du fleuve Rhin. Ces informations ont été générées sur base de relevés bathymétriques et aériens. Elles sont actuellement disponibles sur une zone expérimentale restreinte et délimitée par les bornes kilométriques 170 et 180. La résolution de ce fichier raster est de 1m. / Dieser Datensatz stellt die absoluten Höhen des Flussbettes des Rheins dar. Die Informationen sind mittels Vermessungsboot und Befliegung generiert worden. Sie sind in einzelne Untersuchungsgebiete (AOI) aufgeteilt; hier Flusskilometer 170-180. Die Auflösung beträgt 1m.",
      "schema:keywords": [
        "bathy_km170-180",
        "WCS",
        "GeoTIFF"
      ],
      "schema:spatialCoverage": [
        {
          "@type": [
            "schema:Place"
          ],
          "schema:geo": {
            "@type": [
              "schema:GeoShape"
            ],
            "schema:box": "47.590174 7.519137 47.664921 7.594764"
          }
        }
      ],
      "schema:relatedLink": [
        {
          "@type": [
            "schema:LinkRole"
          ],
          "schema:linkRelationship": "describedby",
          "schema:target": {
            "@type": [
              "schema:EntryPoint"
            ],
            "schema:url": "https://geoportal.georhena.eu/geonetwork/srv/api/records/a549b16c-e8a2-40df-9fce-f43ad2ca945a/formatters/xml"
          }
        }
      ]
    },
    {
      "@id": "https://geoportal.georhena.eu/geoserver/ows?service=WMS&request=GetCapabilities#layer/environment:AOI_ombrage_rhin",
      "@type": [
        "schema:CreativeWork"
      ],
      "schema:additionalType": [
        "WMS layer"
      ],
      "schema:name": "Ombrage du fond du Rhin / Schummerung des Flussbettes des Rheins",
      "schema:identifier": "environment:AOI_ombrage_rhin",
      "schema:description": "Cette donnée propose un ombrage du relief du fond du fleuve Rhin. Ces informations ont été générées sur base de relevés bathymétriques et aériens. Elles sont actuellement disponibles sur une zone expérimentale restreinte et délimitée par les bornes kilométriques 170 et 180. La résolution de ce fichier raster est de 1m. / Dieser Datensatz stellt eine Schummerung des Flussbettes des Rheins dar. Die Informationen sind mittels Vermessungsboot und Befliegung generiert worden. Sie sind in einzelne Untersuchungsgebiete (AOI) aufgeteilt; hier Flusskilometer 170-180. Die Auflösung beträgt 1m.",
      "schema:keywords": [
        "ombrage_km170-180",
        "WCS",
        "GeoTIFF"
      ],
      "schema:spatialCoverage": [
        {
          "@type": [
