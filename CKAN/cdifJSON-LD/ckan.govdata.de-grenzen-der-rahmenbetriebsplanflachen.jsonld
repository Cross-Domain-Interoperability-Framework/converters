  "schema:distribution": [
    {
      "@type": [
        "schema:DataDownload"
      ],
      "schema:contentUrl": "https://inspire.brandenburg.de/services/bergbau_wms?REQUEST=GetCapabilities&SERVICE=WMS",
      "schema:name": "WMS Bergbau BB (WMS-BERGBAU)",
      "schema:description": "Der Darstellungsdienst (WMS) Bergbau Brandenburg stellt Daten zu den Standorten, der unter Bergaufsicht stehenden Betriebsstätten, des Bergbaues, die Felder aktuell bestehender Bergbaubauberechtigungen auf bergfreie Bodenschätze, die Gültigkeitsbereiche von Betriebsplänen (Abschluß-, Haupt- und Rahmenbetriebsplanflächen), die Flächen der Baubeschränkungsgebiete sowie die Altbergbauflächen bereit. Die Gültigkeitsbereiche der Betriebspläne gliedern sich in Rahmen-, Haupt- und Abschlussbetriebspläne. Betriebspläne werden auf der Grundlage des BBergG durch das LBGR zugelassen. Baubeschränkungsgebiete sind jene Flächen, in denen eine baurechtliche Genehmigung oder Zustimmung oder eine diese einschließende Genehmigung für die Errichtung, Erweiterung, Änderung oder Nutzungsänderung baulicher Anlagen nur mit Zustimmungen der Bergbehörde erteilt werden darf. Die Betriebsstätten sind die Standorte der unter Bergaufsicht stehenden Betriebe des Erkundungs-, Gewinnungs-, Sanierungs- und Speicherbergbaues in Brandenburg. Bergbauberechtigungen berechtigen in Form einer Erlaubnis zur Erkundung, in Form einer Bewilligung oder eines Bergwerkseigentums zur Aufsuchung und Gewinnung bergfreier Bodenschätze. Sie werden für räumlich durch Koordinaten definierte Felder erteilt bzw. verliehen. Bei Flächen unter Bergaufsicht (§ 69 Abs. 1 Bundesberggesetz) unterliegt die Aufsicht über diese Flächen der zuständigen Behörde (LBGR). Unter dem Begriff Altbergbau bezeichnet man Bereiche oder Anlagen, in denen früher Bergbau umgegangen ist und die nicht mehr der bergbehördlichen Aufsicht unterliegen. Der WMS beinhaltet die folgenden Layer: - Betriebsstätten [bgbetriebsst], - Sole [bgberechtig_sole], - Steinsalz [bgberechtig_steinsalz], - Ton [bgberechtig_ton], - Torf [bgberechtig_torf], - Untergrundspeicherung [bgberechtig_untergrundspeicherung], - Braunkohle [bgberechtig_braunkohle], - Erdöl und Erdgas [bgberechtig_erdoel_erdgas], - Erdwärme [bgberechtig_erdwaerme], - Erze [bgberechtig_erze], - Hartgestein [bgberechtig_hartgestein], - Kiese und Sande [bgberechtig_kiese_sande], - Rahmenbetriebsplan [bgbprahmen], - Hauptbetriebsplan [bgbphaupt], - Abschlussbetriebsplan [bgbpabschluss], - Baubeschränkungsgebiete [bgbaubeschr], - Altbergbaugebiete [altbergbaugebiete], - Pufferzonen (50m) [pufferzonen_50m], - Flächen unter Bergaufsicht [fl_bergaufsicht].",
      "schema:encodingFormat": [
        "http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"
      ]
    },
    {
      "@type": [
        "schema:DataDownload"
      ],
      "schema:contentUrl": "https://geo.brandenburg.de/?page=Bergbau",
      "schema:name": "Fachinformationssystem Bergbau",
      "schema:description": "Fachinformationssystem Bergbau",
      "schema:encodingFormat": [
        "http://publications.europa.eu/resource/authority/file-type/HTML"
      ]
    },
    {
      "@type": [
        "schema:DataDownload"
      ],
      "schema:contentUrl": "https://ogc-api.geobasis-bb.de/datasets/bergbau",
      "schema:name": "OAF Bergbau BB (OAF-BERGBAU)",
      "schema:description": "Der Downloaddienst (OAF) Bergbau Brandenburg stellt Daten zu den Standorten, der unter Bergaufsicht stehenden Betriebsstätten, des Bergbaues, die Felder aktuell bestehender Bergbaubauberechtigungen auf bergfreie Bodenschätze, die Gültigkeitsbereiche von Betriebsplänen (Abschluß-, Haupt- und Rahmenbetriebsplanflächen), die Flächen der Baubeschränkungsgebiete sowie die Altbergbauflächen bereit. Die Gültigkeitsbereiche der Betriebspläne gliedern sich in Rahmen-, Haupt- und Abschlussbetriebspläne. Betriebspläne werden auf Grundlage des BBergG durch das LBGR zugelassen. Baubeschränkungsgebiete sind jene Flächen, in denen eine baurechtliche Genehmigung oder Zustimmung oder eine diese einschließende Genehmigung für die Errichtung, Erweiterung, Änderung oder Nutzungsänderung baulicher Anlagen nur mit Zustimmungen der Bergbehörde erteilt werden darf. Die Betriebsstätten sind die Standorte der unter Bergbauficht stehenden Betriebe des Erkundungs-, Gewinnungs-, Sanierungs- und Speicherbergbaues in Brandenburg. Bergbauberechtigungen berechtigen in Form einer Erlaubnis zur Erkundung, in Form einer Bewilligung oder eines Bergwerkseigentums zur Aufsuchung und Gewinnung bergfreier Bodenschätze. Sie werden für räumlich durch Koordinaten definierte Felder erteilt bzw. verliehen. Bei Flächen unter Bergaufsicht (§ 69 Abs. 1 Bundesberggesetz) unterliegt die Aufsicht über diese Flächen der zuständigen Behörde (LBGR). Unter dem Begriff Altbergbau bezeichnet man Bereiche oder Anlagen, in denen früher Bergbau umgegangen ist und die nicht mehr der bergbehördlichen Aufsicht unterliegen. Die API beinhaltet die folgenden Collections: - Betriebsstätten, - Bergbauberechtigungen, - Rahmenbetriebsplan, - Hauptbetriebsplan, - Abschlussbetriebsplan, - Baubeschränkungsgebiete, - Altbergbaugebiete, - Pufferzonen (50m), - Flächen unter Bergaufsicht.",
      "schema:encodingFormat": [
        "Download"
      ]
    },
    {
      "@type": [
        "schema:DataDownload"
      ],
      "schema:contentUrl": "https://inspire.brandenburg.de/services/bergbau_wfs?REQUEST=GetCapabilities&SERVICE=WFS",
      "schema:name": "WFS Bergbau BB (WFS-BERGBAU)",
      "schema:description": "Der Downloaddienst (WFS) Bergbau Brandenburg stellt Daten zu den Standorten, der unter Bergaufsicht stehenden Betriebsstätten, des Bergbaues, die Felder aktuell bestehender Bergbaubauberechtigungen auf bergfreie Bodenschätze, die Gültigkeitsbereiche von Betriebsplänen (Abschluß-, Haupt- und Rahmenbetriebsplanflächen), die Flächen der Baubeschränkungsgebiete sowie die Altbergbauflächen bereit. Die Gültigkeitsbereiche der Betriebspläne gliedern sich in Rahmen-, Haupt- und Abschlussbetriebspläne. Betriebspläne werden auf Grundlage des BBergG durch das LBGR zugelassen. Baubeschränkungsgebiete sind jene Flächen, in denen eine baurechtliche Genehmigung oder Zustimmung oder eine diese einschließende Genehmigung für die Errichtung, Erweiterung, Änderung oder Nutzungsänderung baulicher Anlagen nur mit Zustimmungen der Bergbehörde erteilt werden darf. Die Betriebsstätten sind die Standorte der unter Bergbauficht stehenden Betriebe des Erkundungs-, Gewinnungs-, Sanierungs- und Speicherbergbaues in Brandenburg. Bergbauberechtigungen berechtigen in Form einer Erlaubnis zur Erkundung, in Form einer Bewilligung oder eines Bergwerkseigentums zur Aufsuchung und Gewinnung bergfreier Bodenschätze. Sie werden für räumlich durch Koordinaten definierte Felder erteilt bzw. verliehen. Bei Flächen unter Bergaufsicht (§ 69 Abs. 1 Bundesberggesetz) unterliegt die Aufsicht über diese Flächen der zuständigen Behörde (LBGR). Unter dem Begriff Altbergbau bezeichnet man Bereiche oder Anlagen, in denen früher Bergbau umgegangen ist und die nicht mehr der bergbehördlichen Aufsicht unterliegen. Der WFS beinhaltet die folgenden FeatureType: - Betriebsstätten [app:bgbetriebsst], - Bergbauberechtigungen [app:bgberechtig], - Rahmenbetriebsplan [app:bgbprahmen], - Hauptbetriebsplan [app:bgbphaupt], - Abschlussbetriebsplan [app:bgbpabschluss], - Baubeschränkungsgebiete [app:bgbaubeschr], - Altbergbaugebiete [app:altbergbaugebiete], - Pufferzonen (50m) [app:pufferzonen_50m], - Flächen unter Bergaufsicht [app:fl_bergaufsicht].",
      "schema:encodingFormat": [
        "http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"
      ]
    }
  ],
