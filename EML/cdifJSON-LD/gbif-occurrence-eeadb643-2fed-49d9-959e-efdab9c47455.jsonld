  "schema:spatialCoverage": [
    {
      "@type": [
        "schema:Place"
      ],
      "schema:description": "Este trabajo se realizó en los municipios de la Dorada, Samaná, Norcasia, Victoria y Pensilvania (corregimiento Pueblo Nuevo), del departamento de Caldas, Colombia.",
      "schema:geo": {
