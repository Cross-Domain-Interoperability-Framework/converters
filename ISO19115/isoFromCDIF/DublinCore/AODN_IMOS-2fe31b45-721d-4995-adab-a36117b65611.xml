      <mri:citation>
        <cit:CI_Citation>
          <cit:title>
            <gco:CharacterString>IMOS - Ocean Gliders - Slocum glider deployment in Western Australia off Two Rocks (April 2009)</gco:CharacterString>
          </cit:title>
          <cit:identifier>
            <mcc:MD_Identifier>
              <mcc:code>
                <gco:CharacterString>2fe31b45-721d-4995-adab-a36117b65611</gco:CharacterString>
              </mcc:code>
              <mcc:codeSpace>
                <gco:CharacterString>dc:identifier</gco:CharacterString>
