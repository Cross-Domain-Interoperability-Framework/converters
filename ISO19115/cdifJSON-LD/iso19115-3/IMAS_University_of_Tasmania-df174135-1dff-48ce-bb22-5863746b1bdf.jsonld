  "prov:wasGeneratedBy": [
    {
      "@type": [
        "schema:Action",
        "prov:Activity"
      ],
      "schema:name": "Lineage",
      "schema:actionProcess": "The experimental reefs were constructed from concrete pavers elevated 0.3 m above sandy substratum on a steel frame. The 28 reefs comprised seven different patch sizes (0.12, 0.24, 0.48, 1.08, 1.92, 4.32 and 7.68 m2) crossed with four kelp density treatments (zero (0), low (4.1), medium (8.3) and high (16.6 kelp m-2). Macroinvertebrates were assessed by diver-based visual surveys conducted at three stages of the experiment: early (spring: November 2015), middle (autumn: March–April 2016) and late (spring: November–December 2016), approximately 11, 16 and 23 months respectively after the reefs were deployed."
    }
  ],
