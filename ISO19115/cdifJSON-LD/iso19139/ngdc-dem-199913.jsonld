  "prov:wasGeneratedBy": [
    {
      "@type": [
        "schema:Action",
        "prov:Activity"
      ],
      "schema:name": "Common horizontal reference frames and vertical datums are established among disparate data and data are converted to...",
      "schema:actionProcess": "Common horizontal reference frames and vertical datums are established among disparate data and data are converted to a common data format, ASCII xyz, prior to gridding/interpolating. A variety of software can be used for projection/datum transformations and format conversions, including (but not limited to) Geospatial Data Abstraction Library (GDAL) software utilities, VDatum, ArcGIS, LAStools, etc. Once consistency among the input source data is established, the DEM surface is created through gridding and interpolation. Elevations in grid-cells constrained by source measurements are assigned a value according to a weighted average of all samples located within the particular cell, while elevations in unconstrained grid-cells are estimated through interpolation. Please see the DEM technical reports for a more detailed explanation of specific processing steps.",
      "schema:endTime": "2018-02-01T00:00:00",
      "schema:agent": {
        "@type": [
          "schema:Organization"
        ],
        "schema:name": "NOAA National Centers for Environmental Information",
        "schema:email": "dem.info@noaa.gov"
      }
    },
    {
      "@type": [
        "schema:Action",
        "prov:Activity"
      ],
      "schema:name": "NOAA created the National Centers for Environmental Information (NCEI) by merging NOAA's National Climatic Data Cente...",
      "schema:actionProcess": "NOAA created the National Centers for Environmental Information (NCEI) by merging NOAA's National Climatic Data Center (NCDC), National Geophysical Data Center (NGDC), and National Oceanographic Data Center (NODC), including the National Coastal Data Development Center (NCDDC), per the Consolidated and Further Continuing Appropriations Act, 2015, Public Law 113-235. NCEI launched publicly on April 22, 2015.",
      "schema:endTime": "2015-04-22T00:00:00"
    }
  ],
