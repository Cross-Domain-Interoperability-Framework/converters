  "prov:wasGeneratedBy": [
    {
      "@type": [
        "schema:Action",
        "prov:Activity"
      ],
      "schema:name": "Date, time, latitude, and longitude were extracted from files produced by shipboard equipment for each dive. Trackpoi...",
      "schema:actionProcess": "Date, time, latitude, and longitude were extracted from files produced by shipboard equipment for each dive. Trackpoint measurements were thinned to approximately every 5 minutes for the duration of a dive. Text files containing the values were imported into Excel, then ArcMap, and a shapefile was created. Fields were added and populated in order to match an existing data layer. The shapefile was then appended to the submersible trackpoint data layer in ArcSDE.",
