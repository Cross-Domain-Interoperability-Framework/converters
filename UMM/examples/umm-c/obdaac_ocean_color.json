ngDateTime":"2002-07-04T00:00:00Z"}]}],"ProcessingLevel":{"Id":"2"},"DOI":{"Authority":"https://doi.org","DOI":"10.5067/AQUA/MODIS/L2/OC/2022.0"},"ShortName":"MODISA_L2_OC","EntryTitle":"Aqua MODIS Level-2 Regional  Ocean Color (OC) Data, version 2022.0","ISOTopicCategories":["OCEANS"],"DirectDistributionInformation":{"S3CredentialsAPIDocumentationURL":"https://obdaac-tea.earthdatacloud.nasa.gov/s3credentialsREADME","S3BucketAndObjectPrefixNames":["s3://ob-cumulus-prod-public/"],"Region":"us-west-2","S3CredentialsAPIEndpoint":"https://obdaac-tea.earthdatacloud.nasa.gov/s3credentials"},"RelatedUrls":[{"Subtype":"Earthdata Search","Type":"GET DATA","URLContentType":"DistributionURL","URL":"https://search.earthdata.nasa.gov/search/granules?p=C3380708980-OB_CLOUD","Description":"Earthdata Search allows users to search, discover, visualize, refine, and access NASA Earth Observation data."},{"URL":"https://oceancolor.gsfc.nasa.gov/data/reprocessing/","URLContentType":"PublicationURL","Description":"View the version history of this product.","Subtype":"Processing History","Type":"VIEW RELATED INFORMATION"},{"Subtype":"General Documentation","Type":"View Related Information","Description":"This document decribes ancillary data types and usage in OB.DAAC datasets.","URLContentType":"PublicationURL","URL":"https://oceancolor.gsfc.nasa.gov/files/obdaac-ancillary-data-sources.pdf"},{"Type":"GET DATA","Subtype":"DIRECT DOWNLOAD","URL":"https://oceandata.sci.gsfc.nasa.gov/directdataaccess/Level-2/Aqua-MODIS/","URLContentType":"DistributionURL","Description":"NASA's Ocean Color Web - Data Distribution Site"},{"Type":"VIEW RELATED INFORMATION","Description":"Aqua Homepage","URL":"https://www.earthdata.nasa.gov/data/platforms/space-based-platforms/Aqua","URLContentType":"PublicationURL"},{"Type":"VIEW RELATED INFORMATION","Description":"MODIS Homepage","URL":"https://www.earthdata.nasa.gov/data/instruments/MODIS","URLContentType":"PublicationURL"},{"Subtype":"DATA RECIPE","Type":"VIEW RELATED INFORMATION","Description":"Satellite data procesing can be difficult. We're here to help! Visit the Oceandata Help Hub to navigate learning content for accessing visualizing, and analyzing data products.","URLContentType":"PublicationURL","URL":"https://nasa.github.io/oceandata-notebooks/"}],"SpatialInformation":{"SpatialCoverageType":"HORIZONTAL","VerticalCoordinateSystem":{"AltitudeSystemDefinition":{"DatumName":"EPSG4326"}}},"DataDates":[{"Type":"CREATE","Date":"2025-01-23T00:00:00Z"},{"Type":"UPDATE","Date":"2025-01-23T00:00:00Z"}],"Abstract":"The Ocean Color (OC) data suite provides calibrated, atmospherically corrected ocean-optics measurements and derived biogeophysical products. This data suite includes the Apparent Optical Properties (AOP) and provides satellite-derived measures of the interaction between solar radiation and the upper ocean. AOPs are “apparent” because they depend not only on the inherent optical properties (IOPs) of seawater and its constituents but also on the ambient light field. These variables are critical for studying light penetration, primary productivity, and biogeochemical cycling.\n\n Geophysical variables in this suite include:\n  - Kd_490 - Diffuse attenuation coefficient at 490 nm, KD2 algorithm (m⁻¹)\n  - Rrs - Remote sensing reflectance (sr⁻¹)\n  - angstrom - Aerosol Angstrom exponent, 443 to 865 nm\n  - chlor_a - Chlorophyll Concentration, OCI Algorithm (mg m⁻³)\n- l2_flags - Level-2 Processing Flags\n- aot_869 - Aerosol optical thickness at 869 nm\n- ipar - Instantaneous Photosynthetically Available Radiation (einstein m⁻² s⁻¹)\n- nflh - Normalized Fluorescence Line Height (W m⁻² um⁻¹ sr⁻¹)\n- par - Photosynthetically Available Radiation, R. Frouin (einstein m⁻² day⁻¹)\n- pic - Calcite Concentration, Balch and Gordon (mol m⁻³)\n- poc - Particulate Organic Carbon, D. Stramski, 2007 (443/555 version) (mg m⁻³)","LocationKeywords":[{"Category":"GEOGRAPHIC REGION","Type":"GLOBAL OCEAN"}],"Version":"2022.0","CollectionDataType":"SCIENCE_QUALITY","DataCenters":[{"Roles":["PROCESSOR"],"LongName":"Ocean Biology Processing Group","ShortName":"OBPG"},{"ShortName":"NASA/GSFC/SED/ESD/GCDC/OB.DAAC","ContactInformation":{"ContactMechanisms":[{"Type":"Email","Value":"sdps@oceancolor.gsfc.nasa.gov"},{"Value":"301-286-0268","Type":"Fax"}]},"LongName":"Ocean Biology Distributed Active Archive Center (OB.DAAC), Global Change Data Center, Earth Sciences Division, Science and Exploration Directorate, Goddard Space Flight Center, NASA","Roles":["DISTRIBUTOR","ARCHIVER"]}],"Platforms":[{"LongName":"Earth Observing System, Aqua","ShortName":"Aqua","Instruments":[{"LongName":"Moderate-Resolution Imaging Spectroradiometer","ShortName":"MODIS"}],"Type":"Earth Observation Satellites"}],"MetadataSpecification":{"URL":"https://cdn.earthdata.nasa.gov/umm/collection/v1.18.6","Name":"UMM-C","Version":"1.18.6"},"ArchiveAndDistributionInformation":{"FileDistributionInformation":[{"Format":"netCDF-4"}]}}}]}