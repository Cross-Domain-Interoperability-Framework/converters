    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "SV_END_POSITION",
      "schema:description": "Satellite position vector in fixed earth coordinates. Comma-separated list of three numbers."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "SV_END_VELOCITY",
      "schema:description": "Satellite velocity vector in fixed earth coordinates. Comma-separated list of three numbers."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "POLARIZATION",
      "schema:description": "Radar transmissions are polarized, with components normally termed vertical (V) and horizontal (H). Vertical means that the electric vector is in the plane of incidence; horizontal means the electric vector is perpendicular to the plane of incidence."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "FLIGHT_LINE",
      "schema:description": "Flight line identifies where the aircraft/instrument has flown to acquire data."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "BEAM_MODE",
      "schema:description": "The general type of active sensor used. Values indicate image resolution: such as standard, fine, wide, scansar wide, SM (strip mode), EW (extra wide). Or indicate resolution + polarization: FBS (fine beam single polarization), FBD (fine beam dual pol). Or atypically the type of product: TOPSAR (high resolution DEM), RPI (repeat pass interferometry), XTI (across track interferometry). Or resolution and product type IW (interferometric wide)."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "BEAM_MODE_DESC",
      "schema:description": "Text that describes the beam mode"
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "BEAM_MODE_TYPE",
      "schema:description": "In most cases, the BEAM_MODE_TYPE value is the same as the BEAM_MODE attribute. Each platform has its own scheme for defining acquisition sensor beam modes. Beam modes often reflect a set configuration of polarization, resolution, and off-nadir pointing angle."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "FARADAY_ROTATION",
      "schema:description": "An effect of the ionosphere that rotates polarizations from HH or VV or HV or VH. Significant for L or P band. Rotation over 5 degrees reduces usefulness for applications such as forest biomass. Effect is reduced at solar minimum."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "INSAR_STACK_ID",
      "schema:description": "An ASF-assigned unique number used internally to unify SAR images over the same location. Used for data that might be used for interferometry."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "INSAR_STACK_SIZE",
      "schema:description": "The number of SAR images over the same location in the entire ASF archive. Used for data that may be used for interferometry."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "INSAR_BASELINE",
      "schema:description": "The perpendicular distance between two satellites when they took the related two images. Useful for identifying image pairs to use for interferometry."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "DOPPLER",
      "schema:description": "The doppler centroid frequency - Useful for SAR processing and interferometry. Related to the squint of the satellite."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "ASCENDING_DESCENDING",
      "schema:description": "Describes whether the satellite travel direction was ascending towards the north pole, or descending towards the south pole."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "THUMBNAIL_URL",
      "schema:description": "URL that points to this granule's thumbnail image"
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "CENTER_FRAME_ID",
      "schema:description": "ID of the center frame"
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "PATH_NUMBER",
      "schema:description": "The path describes a path the satellite will follow over the earth similar to longitude; each path has an assigned number. Combined with a frame number it identifies a specific piece of ground."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "FRAME_NUMBER",
      "schema:description": "The designated frame or scene as defined by various space agencies (ESA, JAXA, CSA) each of which have their own scheme. The frame describes a box over the Earth at a fixed latitude. Combined with a path number (for longitude it identifies a specific piece of ground)."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "CENTER_ESA_FRAME",
      "schema:description": "The European Space Agency equivalent to the value in the FRAME_NUMBER field"
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "MISSION_NAME",
      "schema:description": "The sitenames where AIRSAR, AIRMOSS, and UAVSAR acquisitions were taken."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "GRANULE_TYPE",
      "schema:description": "Identifies the type of data by combining platform, beam mode type, and coverage (frame/swath)"
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "PROCESSING_DATE",
      "schema:description": "The date the data was processed"
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "PROCESSING_DESCRIPTION",
      "schema:description": "Describes what the data was processed to. For example: low resolution terrain corrected ALOS data."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "LOOK_DIRECTION",
      "schema:description": "SAR imagery is taken with the sensor pointing either left or right of the satellite. Most data is right-looking."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "PROCESSING_TYPE",
      "schema:description": "Indicates the type of product, such as browse, metadata, L1, complex, amplitude, projected, terrain corrected."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "PROCESSING_LEVEL",
      "schema:description": "Indicates how much processing has been done to the data: L1, L1.0 unprocessed; L1.1 single look complex; L1, L1.5 amplitude image; L2, L2.2 terrain corrected image."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "PROCESSING_TYPE_DISPLAY",
      "schema:description": "Label that will be displayed in ASF's Vertex interface"
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "BYTES",
      "schema:description": "Product size in bytes."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "MD5SUM",
      "schema:description": "Checksum"
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "OFF_NADIR_ANGLE",
      "schema:description": "The angle the sensor points away from the satellite's nadir (off to the side). Larger angles correspond to imaging farther away from the satellite."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "ACQUISITION_DATE",
      "schema:description": "Date the data was acquired by the satellite or aircraft and instrument."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "CENTER_LON",
      "schema:description": "Longitude of the center of the scene or frame."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "CENTER_LAT",
      "schema:description": "Latitude of the center of the scene or frame."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "NEAR_START_LAT",
      "schema:description": "Latitude of the granule where imaging began nearest to the satellite. For an ascending satellite, it locates the lower left corner of a north-oriented image."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "NEAR_START_LON",
