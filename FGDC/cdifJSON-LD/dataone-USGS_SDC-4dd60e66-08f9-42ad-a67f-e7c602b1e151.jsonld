  "prov:wasGeneratedBy": [
    {
      "@type": [
        "schema:Action",
        "prov:Activity"
      ],
      "schema:name": "Process step",
      "schema:actionProcess": "The province geologist mapped the Total Petroleum System boundary on a hard copy base map at 1:2,000,000 provided by the project after plotting all available geologic and geophysical well data and information on the hard copy base map. Similarly, data contained in the IHS Energy Group, WHCS data base for wells (2007 update), and the Nehring Significant Oil and Gas Field File (2005 update) were plotted on the base map for reference. Following review, the Total Petroleum System boundary was digitally transferred from the hard copy base map using Arcedit."
    },
    {
      "@type": [
        "schema:Action",
        "prov:Activity"
      ],
      "schema:name": "Process step",
      "schema:actionProcess": "The coverage was projected to Lambert Conformal Conic, the Bakken - Lodgepole Total Petroleum System was selected and placed into this unique coverage. The data were then projected to Geographic, NAD 83, for consistency with data in other provinces.",
      "schema:endTime": "2008"
    },
    {
      "@type": [
        "schema:Action",
        "prov:Activity"
      ],
      "schema:name": "Process step",
      "schema:actionProcess": "Dataset copied."
    },
    {
      "@type": [
        "schema:Action",
        "prov:Activity"
      ],
      "schema:name": "Process step",
      "schema:actionProcess": "Metadata imported.",
      "schema:endTime": "2009-03-20"
    }
  ],
