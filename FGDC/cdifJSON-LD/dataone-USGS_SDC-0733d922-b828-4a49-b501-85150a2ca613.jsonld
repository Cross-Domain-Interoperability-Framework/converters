  "schema:name": "HW1_Q13.TIF - Hawaii I - Southeastern Hawaiian Ridge U.S. EEZ GLORIA sidescan-sonar data mosaic (13 of 29) (LCC, 50 m, WGS84)",
  "schema:creator": {
