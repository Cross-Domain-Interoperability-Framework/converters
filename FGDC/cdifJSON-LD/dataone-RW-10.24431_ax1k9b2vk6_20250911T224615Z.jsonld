  "schema:name": "Thermal Habitat Preferences of Pacific Halibut and the Potential Influences of Hydrographic Variability on a Local Coastal Fishery, Summers 2003-2004, Loher, T.",
  "schema:creator": {
    "@list": [
      {
        "@type": [
