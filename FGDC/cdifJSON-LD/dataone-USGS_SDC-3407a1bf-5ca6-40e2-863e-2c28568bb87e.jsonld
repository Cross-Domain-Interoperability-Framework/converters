  "schema:variableMeasured": [
    {
      "@id": "#FID",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "FID",
      "schema:description": "Internal feature number."
    },
    {
      "@id": "#Shape",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "Shape",
      "schema:description": "Feature geometry."
    },
    {
      "@id": "#RouteID",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "RouteID",
      "schema:description": "Route identification value assigned to individual lidar shoreline line segments. A unique cross-shore profile identification value is stored at each vertex of the lidar route and serves as a common attribute to the shoreline uncertainty table (CapeCod_shorelines_uncertainty.dbf)."
    },
    {
      "@id": "#Date_",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "Date_",
      "schema:description": "Date of shoreline position; date of survey as indicated on source material. A default date of 07/01 was assigned to shorelines where only the year was known (month and day unknown). Using July, the mid-point month of the calendar year, minimizes the potential offset to the actual shoreline date by a maximum of six months."
    },
    {
      "@id": "#Uncy",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "Uncy",
      "schema:description": "Estimate of shoreline position uncertainty. Actual shoreline position is within the range of this value (plus or minus, meters). The uncertainty was determined by Equation 2 in USGS Open-File Report (OFR) 2010-1118 (cross-referenced in this metadata file). The historic shoreline uncertainty values contain all of the measurement errors listed in Table 5 of OFR 2010-1118, except for the uncertainty of the High Water Line (HWL). The HWL uncertainty listed in Table 5 was averaged for the entire study region. However, the uncertainty of the HWL at an individual transect can be determined with more precision along the shoreline route. The HWL uncertainty was added to the historic shoreline uncertainty stored in the shoreline attribute table during the DSAS rate calculation process to better account for uncertainty at individual transects alongshore as opposed to using a regionally averaged value. This was done using linear referencing that interpolates a value based on data stored in the shoreline_uncertainty dBase file (.dbf) at a specific transect/shoreline intersect alongshore. The lidar shoreline position uncertainty is also stored in the associated shoreline_uncertainty.dbf file and values are interpolated at specific transect/shoreline intersections using the same linear referencing method. The lidar uncertainty attribute field was filled with null values while residing in the geodatabase. Upon exporting the shoreline feature class to a shapefile for publication, the null values in the lidar uncertainty field were automatically converted to zero values."
    },
    {
      "@id": "#Source",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "Source",
      "schema:description": "Agency that provided shoreline feature or the data source used (e.g. T-sheet) to digitize shoreline feature."
    },
    {
      "@id": "#Shape_Leng",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "Shape_Leng",
      "schema:description": "Length of feature in meters units (UTM zone 19N, WGS 84)",
      "schema:minValue": 6.717709,
      "schema:maxValue": 44644.010927
    },
    {
      "@id": "#Year_",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "Year_",
      "schema:description": "Four digit year of shoreline",
      "schema:minValue": 1848.0,
      "schema:maxValue": 2000.0
    },
    {
      "@id": "#Default_D",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "Default_D",
      "schema:description": "Differentiates between shorelines that have known month and day attributes and those that use the default value of 07/01 when only the year is known."
    }
  ],
