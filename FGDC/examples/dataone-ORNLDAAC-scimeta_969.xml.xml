        <title>ISLSCP II UNIVERSITY OF MARYLAND GLOBAL LAND COVER CLASSIFICATIONS, 1992-1993</title>

		    
     			<onlink>http://daac.ornl.gov/cgi-bin/dsviewer.pl?ds_id=969</onlink>
    		
    		
    
