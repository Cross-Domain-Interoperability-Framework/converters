    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "Notes: 4.",
      "schema:value": "The format of the data in the CredentialNumber column was changed during an update of the underlying data system in March 2026. The new format and a list of license prefixes and suffixes is now attached in the document titled \"DOH_HELMS_License Types_AlphaPrefixSuffixDictionary\" listed below."
    },
    {
      "@type": [
        "schema:PropertyValue"
      ],
      "schema:name": "Notes: 5.",
      "schema:value": "The provider birth year column results have been removed from this data set for information privacy. The column and column title are available to prevent interruptions in data validation."
