      "schema:name": "hhs_ids",
      "schema:description": "As a part of an effort to improve the granularity of spatial data, unique identifiers (named “HHS IDs” in the datasets) have been assigned to each individual facility. These unique identifiers are provided so data users can reference each individual “brick and mortar” facility that is reporting data to HHS, even in cases when multiple facilities report under the same CMS Certification Number (CCN). Additional datasets and further details related to HHS IDs will be released at a later date.",
      "cdif:physicalDataType": "xsd:string"
    },
