  "schema:name": "Mixed Beverage Gross Receipts",
  "schema:description": "This file contains a list of taxpayers required to report mixed beverage gross receipts tax reports under Tax Code Chapter 183, Subchapter B. The list provides taxpayer names, amounts reported, and other public information.\r\n\r\nSee https://comptroller.texas.gov/about/policies/privacy.php for more information on our agency’s privacy and security policies",
  "schema:identifier": "naix-2893",
  "schema:keywords": [
    "mixed beverage",
    "receipts"
  ],
