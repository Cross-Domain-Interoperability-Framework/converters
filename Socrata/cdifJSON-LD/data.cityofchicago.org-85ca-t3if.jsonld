    {
      "@id": "#injuries_total",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "INJURIES_TOTAL",
      "schema:alternateName": [
        "injuries_total"
      ],
      "schema:description": "Total persons sustaining fatal, incapacitating, non-incapacitating, and possible injuries as determined by the reporting officer",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#injuries_fatal",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "INJURIES_FATAL",
      "schema:alternateName": [
        "injuries_fatal"
      ],
      "schema:description": "Total persons sustaining fatal injuries in the crash",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#injuries_incapacitating",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "INJURIES_INCAPACITATING",
      "schema:alternateName": [
        "injuries_incapacitating"
      ],
      "schema:description": "Total persons sustaining incapacitating/serious injuries in the crash as determined by the reporting officer. Any injury other than fatal injury, which prevents the injured person from walking, driving, or normally continuing the activities they were capable of performing before the injury occurred. Includes severe lacerations, broken limbs, skull or chest injuries, and abdominal injuries.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#injuries_non_incapacitating",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "INJURIES_NON_INCAPACITATING",
      "schema:alternateName": [
        "injuries_non_incapacitating"
      ],
      "schema:description": "Total persons sustaining non-incapacitating injuries in the crash as determined by the reporting officer. Any injury, other than fatal or incapacitating injury, which is evident to observers at the scene of the crash. Includes lump on head, abrasions, bruises, and minor lacerations.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#injuries_reported_not_evident",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "INJURIES_REPORTED_NOT_EVIDENT",
      "schema:alternateName": [
        "injuries_reported_not_evident"
      ],
      "schema:description": "Total persons sustaining possible injuries in the crash as determined by the reporting officer. Includes momentary unconsciousness, claims of injuries not evident, limping, complaint of pain, nausea, and hysteria.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#injuries_no_indication",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "INJURIES_NO_INDICATION",
      "schema:alternateName": [
        "injuries_no_indication"
      ],
      "schema:description": "Total persons sustaining no injuries in the crash as determined by the reporting officer",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#injuries_unknown",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "INJURIES_UNKNOWN",
      "schema:alternateName": [
        "injuries_unknown"
      ],
      "schema:description": "Total persons for whom injuries sustained, if any, are unknown",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#crash_hour",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "CRASH_HOUR",
      "schema:alternateName": [
        "crash_hour"
      ],
      "schema:description": "The hour of the day component of CRASH_DATE.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#crash_day_of_week",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "CRASH_DAY_OF_WEEK",
      "schema:alternateName": [
        "crash_day_of_week"
      ],
      "schema:description": "The day of the week component of CRASH_DATE. Sunday=1",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#idot_control_no",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "IDOT_CONTROL_NO",
      "schema:alternateName": [
        "idot_control_no"
      ],
      "schema:description": "A unique 10-digit number for each crash report, assigned by the Illinois Department of Transportation. Amended reports and additional pages for the same crash report will have the same IDOT Control Number.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#latitude",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "LATITUDE",
      "schema:alternateName": [
        "latitude"
      ],
      "schema:description": "The latitude of the crash location, as determined by reporting officer, as derived from the reported address of crash",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#longitude",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "LONGITUDE",
      "schema:alternateName": [
        "longitude"
      ],
      "schema:description": "The longitude of the crash location, as determined by reporting officer, as derived from the reported address of crash",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#location",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "LOCATION",
      "schema:alternateName": [
        "location"
      ],
      "schema:description": "The crash location, as determined by reporting officer, as derived from the reported address of crash, in a column type that allows for mapping and other geographic analysis in the data portal software",
      "cdif:physicalDataType": "xsd:string"
    }
  ],
