      "@type": [
        "schema:WebAPI"
      ],
      "schema:name": "Socrata Open Data API (SODA) endpoint",
      "schema:serviceType": "Socrata Open Data API (SODA)",
      "schema:termsOfService": "not specified",
      "schema:documentation": "https://dev.socrata.com/foundry/www.datos.gov.co/jbjy-vk9h",
      "schema:potentialAction": [
        {
          "@type": [
            "schema:SearchAction"
          ],
          "schema:name": "Query rows",
          "schema:target": {
            "@type": [
              "schema:EntryPoint"
            ],
            "schema:description": "Columns are named by their API field name (the alternate name of each variable). Results are paged.",
            "schema:urlTemplate": "https://www.datos.gov.co/resource/jbjy-vk9h.{format}?$select={select}&$where={where}&$order={order}&$limit={limit}&$offset={offset}",
            "schema:httpMethod": [
              "GET"
            ]
          },
          "schema:query-input": [
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "format",
              "schema:description": "The response format: json, csv or geojson.",
              "schema:valueRequired": true,
              "schema:valuePattern": "json|csv|geojson"
            },
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "select",
              "schema:description": "SoQL $select: the columns to return, by API field name. Empty for all.",
              "schema:valueRequired": false
            },
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "where",
              "schema:description": "SoQL $where: a filter on the rows. Empty for none.",
              "schema:valueRequired": false
            },
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "order",
              "schema:description": "SoQL $order: the column(s) to sort by. Empty for the default order.",
              "schema:valueRequired": false
            },
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "limit",
