  "schema:variableMeasured": [
    {
      "@id": "#id",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "id",
      "schema:description": "PDC internal identifier that corresponds to unique record for a lobbyist in a given year.",
      "cdif:physicalDataType": "xsd:string",
      "cdif:role": "UnitIdentifier"
    },
    {
      "@id": "#report_number",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "report_number",
      "schema:description": "This is the identifying number of the filed L2 from the PDC Accesshub online filing system.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#origin",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "origin",
      "schema:description": "This value shows how the report was filed: FE = Filed electronically; FP = Paper filed.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#filer_id",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "filer_id",
      "schema:description": "The unique id assigned to a lobbyist. The filer id is consistent across years.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#filer_name",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "filer_name",
      "schema:description": "The lobbyist's registered name. Names remain consistent for each filer within a given election year, but may vary between years if the lobbyist legally changes their name.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#type",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "type",
      "schema:description": "Shows if this report was filed for an employer or for a lobbyist.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#funding_source_id",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "funding_source_id",
      "schema:description": "Unique identifier for the contractual relationship between the firm and client.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#funding_source",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "funding_source_name",
      "schema:alternateName": [
        "funding_source"
      ],
      "schema:description": "Name or label of the the contractual relationship between the firm and client.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#filing_period",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "filing_period",
      "schema:description": "The filing period for this report.",
      "cdif:physicalDataType": "xsd:dateTime"
    },
    {
      "@id": "#first_filed_at",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "first_filed_at",
      "schema:description": "This indicates the first submission date of the L2 report.",
      "cdif:physicalDataType": "xsd:dateTime"
    },
    {
      "@id": "#receipt_date",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "receipt_date",
      "schema:description": "The date that the report was filed.",
      "cdif:physicalDataType": "xsd:dateTime"
    },
    {
      "@id": "#employer_id",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "employer_id",
      "schema:description": "This ID consistently identifies a given lobbyist client/employer across all years in PDC records.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#employer_name",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "employer_name",
      "schema:description": "The name of a given lobbyist client/employer referenced in the L2.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#compensation",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "compensation",
      "schema:description": "Total compensation reported for this client/employer for this L2 and filing period.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#sub_lobbyist_compensation",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "sub_lobbyist_compensation",
      "schema:description": "Payments made to other lobbyists who were hired by the lobbyist or paid by the lobbyist using funds received from the client/employer for this L2 and filing period.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#net_compensation",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "net_compensation",
      "schema:description": "The total compensation the lobbyist received after paying any subcontracted lobbyists for this L2 and filing period.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#personal_expenses",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "personal_expenses",
      "schema:description": "The total amount of all personal expenses for travel, food and refreshments incurred by the lobbyist, from all employers for this L2 and filing period.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#entertainment",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "entertainment",
      "schema:description": "The total amount of expenditures incurred by the lobbyist or lobbyist client/employer(s) for legislators, state officials, state employees and members of their immediate families for this L2 and filing period. Expenditures include meals, beverages, tickets, passes, and other forms of entertainment; receptions; travel, lodging and subsistence expenses for speeches, presentations, appearances, trade missions, seminars or educational programs; and enrollment and course fees for seminars or educational programs.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#contributions",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "contributions",
      "schema:description": "The total amount of contributions to a Washington State candidate or committee that were given or transmitted by the lobbyist for this L2 and filing period. Contributions are described as monetary or in-kind, with in-kind being described as goods or services that were made directly to a political campaign, including political advertising that was coordinated with the campaign.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#advertising",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "advertising",
      "schema:description": "Deprecated field (legacy format only). The total amount of all advertising expenses incurred by the lobbyist, from all employers for this L2 and filing period. Advertising expenses include advertising costs, printing costs, and the cost of informational literature.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#political_ads",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "political_ads",
      "schema:description": "Deprecated field (legacy format only). Total political advertising expenses across all employers for this L2 and filing period. Includes expenditures for political advertising supporting or opposing candidates/ballot measures, plus lobbying-related public relations, telemarketing, polling, and similar activities.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#independent_expenditures_candidate",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "independent_expenditures_candidate",
      "schema:description": "The total amount of independent expenditures made by the lobbyist or lobbyist's client (employer) in support of or opposition to any Washington State candidate that costs $1,000 or more for this L2 and filing period.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#independent_expenditures_ballot",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "independent_expenditures_ballot",
      "schema:description": "The total amount of independent expenditures made by the lobbyist or lobbyist's client (employer) in support of or opposition to any Washington State ballot measure that costs $1,000 or more for this L2 and filing period.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#other",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "other",
      "schema:description": "The total amount of other expenses incurred by the lobbyist, from all employers for this L2 and filing period.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#direct_expenses",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "direct_expenses",
      "schema:description": "The total amount of expenses directly related to lobbying the legislature or state agencies, such as printing and literature, public relations and polling, and consulting and payments to expert witnesses for this L2 and filing period.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#indirect_expenses",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "indirect_expenses",
      "schema:description": "The total amount of indirect lobbying, or grassroots lobbying, involving campaigns funded by client/employer general treasury funds to encourage the public to contact their legislators for this L2 and filing period.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#contributions_total",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "contributions_total",
      "schema:description": "The total amount of contributions for the L2 and filing period.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#total_expenses",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "total_expenses",
      "schema:description": "The total amount of expenses incurred by the lobbyist for this L2 and reporting period, excluding compensation. This sum includes personal expenses, entertainment, contributions, advertising, political ads, independent expenditures (candidate and ballot measure), other expenses, and direct and indirect lobbying expenses.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#net_total",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "net_total",
      "schema:description": "The total of all expenses and compensation, minus any amount paid to a subcontractor to lobby on behalf of a client. Subcontractors report their own compensation and expenses.",
      "cdif:physicalDataType": "xsd:decimal"
    },
    {
      "@id": "#employment_registration_id",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "employment_registration_id",
      "schema:description": "Unique identifier for the contractual relationship between the firm and client.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#employment_type",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "employment_type",
      "schema:description": "Signifies a direct or subcontracted employment relationship.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#contractor_id",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "contractor_id",
      "schema:description": "The unique id assigned to a lobbyist. The contractor id is used to express when a lobbyist is sub contracted for another.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#contractor_name",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "contractor_name",
      "schema:description": "This is the contractor name, as reported on the filed L2.",
      "cdif:physicalDataType": "xsd:string"
    },
    {
      "@id": "#url",
      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "url",
      "schema:description": "Link to the original report filed with the PDC.",
      "cdif:physicalDataType": "xsd:anyURI"
    }
  ],
