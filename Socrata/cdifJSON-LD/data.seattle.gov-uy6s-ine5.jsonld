  "@type": [
    "schema:Dataset"
  ],
  "schema:name": "Tree Service Provider Registry",
  "schema:description": "Database of all active Tree Service Providers registered to do business in Seattle and have met the registration requirements for the Seattle Department of Construction & Inspections (SDCI) registry for tree work on private property, for the Seattle Department of Transportation’s (SDOT) registry for tree work in the public right-of-way, or both. All commercial tree work on private property, including removal, reportable work, or consulting services must be conducted by a SDCI registered tree service provider. All major pruning or tree removal work within the public right-of-way must be conducted by a SDOT registered tree service provider.",
  "schema:identifier": "uy6s-ine5",
  "schema:keywords": [
    "tree service",
    "tree",
    "service",
    "tree service provider",
    "tree service provider registry",
    "registry",
