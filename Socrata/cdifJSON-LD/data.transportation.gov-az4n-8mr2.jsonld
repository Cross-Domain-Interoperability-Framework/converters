  "@type": [
    "schema:Dataset"
  ],
  "schema:name": "Company Census File",
  "schema:description": "The Company Census File contains records for active, inactive, and pending entities registered with FMCSA. Entities include those entities subject to the FMCSR, HMR, or intrastate non-Hazardous Material (HM) carriers. To identify each entity, FMCSA assigns a unique number to each entity record. This number is referred to as the USDOT number.\nEach Census record contains entity identifying data, business operations data, equipment and driver data, and carrier review data.",
  "schema:identifier": "az4n-8mr2",
  "schema:keywords": [
    "census",
    "usdot number",
    "mcmis.",
    {
      "@type": [
        "schema:DefinedTerm"
      ],
