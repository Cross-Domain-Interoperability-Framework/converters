      "journalName": "mBio",
      "name": "The Viral Polymerase Complex Mediates the Interaction of Viral Ribonucleoprotein Complexes with Recycling Endosomes during Sendai Virus Assembly.",
      "pmid": "32843550",
      "url": "https://pubmed.ncbi.nlm.nih.gov/32843550/"
