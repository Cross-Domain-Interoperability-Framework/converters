      "journalName": "Nature",
      "name": "Genome, epigenome and RNA sequences of monozygotic twins discordant for multiple sclerosis.",
      "pmid": "20428171",
      "url": "https://pubmed.ncbi.nlm.nih.gov/20428171/"
    }
