      "@type": "ScholarlyArticle",
      "name": "Protective envelope-dimer epitope-like antibodies are elicited against dengue virus in children following infection and vaccination",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12351287/#S10"
    }
  ],
  "conditionsOfAccess": "Open",
