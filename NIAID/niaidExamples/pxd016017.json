      "datePublished": "2020-06-15",
      "fromPMID": true,
      "identifier": "PMID:32541821",
      "journalName": "Nature communications",
      "name": "Characterization of a pluripotent stem cell-derived matrix with powerful osteoregenerative capabilities.",
      "pmid": "32541821",
