  "schema:sourceOrganization": [
    {
      "@type": [
        "schema:ResearchProject"
      ],
      "schema:alternateName": [
        "AMP",
        "AMP-RA/SLE",
        "Accelerating Medicines Partnership"
      ],
      "cdifniaid:correctionApproved": true,
      "schema:description": "The Accelerating Medicines Partnership (AMP) is a public-private collaboration among the National Institutes of Health, pharmaceutical companies, and non-profit organizations. The goal of the work is to pinpoint the genes, proteins, and cell signaling pathways involved in disease pathogenesis and response to current therapies, and to identify tissue specific targets for new therapies. Network researchers are employing emerging single cell technologies, big data tools, and invaluable samples obtained from consenting rheumatoid arthritis (RA) patients or lupus patients. For more information, visit the NIAID program page: https://www.niaid.nih.gov/research/accelerating-medicines-partnership-rheumatoid-arthritis-lupus\n\nThe Accelerating Medicines Partnership (AMP) is a public-private collaboration aimed at identifying the genes, proteins, and pathways involved in disease progression and treatment response. Using single-cell technologies and big data tools, researchers develop new therapeutic targets for rheumatoid arthritis, lupus, and other diseases.",
      "schema:name": "AMP Network",
      "schema:parentOrganization": [
        "NIH"
      ],
      "schema:url": "https://fnih.org/our-programs/accelerating-medicines-partnership-amp/"
    }
  ],
