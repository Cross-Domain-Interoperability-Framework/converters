      "schema:hasPart": [
        {
          "@type": [
            "schema:MediaObject"
          ],
          "schema:name": "dataset_n2o_subsurfaceContains concentrations of nitrous oxide (N2O) at different depths in soil profiles and measured N2O surface fluxes of three experiments at the Kellogg Biological Station (KBS) Long-term Ecological Research (LTER) site: LTER Main Cropping System Experiment (MCSE, in 2011), Monolith Lysimeters (in 2010-2011), and Resource Gradient Experiment (in 2011). Also includes additional MCSE treatments and well as concurrent concentrations and fluxes of carbon dioxide (CO2) and methane (CH4) for LTER MCSE and Monolith Lysimeters that are not analyzed in the publication.",
          "schema:encodingFormat": [
            "application/octet-stream"
          ]
        }
      ]
    }
