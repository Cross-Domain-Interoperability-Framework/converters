      "schema:datePublished": "2010-04-29",
      "schema:identifier": "PMID:20428171",
      "nde:journalName": "Nature",
      "schema:name": "Genome, epigenome and RNA sequences of monozygotic twins discordant for multiple sclerosis.",
      "nde:pmid": "20428171",
      "schema:url": "https://pubmed.ncbi.nlm.nih.gov/20428171/"
