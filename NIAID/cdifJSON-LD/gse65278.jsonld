  "schema:sourceOrganization": [
    {
      "@type": [
        "schema:ResearchProject"
      ],
      "schema:alternateName": [
        "CFAR",
        "Centers for AIDS Research"
      ],
      "cdifniaid:correctionApproved": true,
      "schema:description": "The Centers for AIDS Research (CFAR) program at the National Institutes of Health provides administrative and shared research support to synergistically enhance and coordinate high quality AIDS research projects. For more information, visit the NIAID program page: https://www.niaid.nih.gov/research/centers-aids-research\n\nThe Centers for AIDS Research (CFAR) provides administrative and research support to enhance and coordinate high-quality HIV/AIDS research. This program fosters collaboration across disciplines to advance scientific discoveries and improve patient outcomes.",
      "schema:name": "NIAID CFAR Program",
      "schema:parentOrganization": [
        "NIAID"
      ],
      "schema:url": "https://www.niaid.nih.gov/research/about-centers-aids-research"
    },
    {
      "@type": [
        "schema:ResearchProject"
      ],
      "schema:alternateName": [
        "HPTN",
        "HIV Prevention Trials Network"
      ],
      "cdifniaid:correctionApproved": true,
      "schema:description": "The HIV Prevention Trials Network (HPTN) develops and tests the safety and efficacy of primarily non-vaccine interventions designed to prevent the transmission of HIV. For more information, visit the NIAID program page: https://www.niaid.nih.gov/research/hiv-prevention-trials-network\n\nThe HIV Prevention Trials Network (HPTN) conducts clinical trials to evaluate the safety and efficacy of non-vaccine HIV prevention strategies. Research areas include pre-exposure prophylaxis, behavioral interventions, and novel biomedical approaches to reduce HIV transmission.",
      "schema:name": "NIAID HPTN Network",
      "schema:parentOrganization": [
        "NIAID"
      ],
      "schema:url": "https://www.hptn.org/"
    },
    {
      "@type": [
        "schema:ResearchProject"
      ],
      "schema:alternateName": [
        "PEPFAR",
        "U.S. President's Emergency Plan for AIDS Relief"
      ],
      "cdifniaid:correctionApproved": true,
      "schema:description": "The United States President’s Emergency Plan for AIDS Relief (PEPFAR) is the U.S. government initiative to help save the lives of those living with and affected by HIV/AIDS around the world. This historic commitment is the largest by any nation to combat a single disease internationally, and PEPFAR investments also help alleviate suffering from other diseases across the global health spectrum. For more information, visit the NIAID program page: https://www.niaid.nih.gov/research/president-emergency-plan-aids-relief\n\nThe United States President’s Emergency Plan for AIDS Relief (PEPFAR) is a U.S. government initiative dedicated to combating HIV/AIDS worldwide through treatment, prevention, and care programs. It represents the largest international commitment by any nation to fight a single disease.",
      "schema:name": "PEPFAR",
      "schema:parentOrganization": [
        "U.S. Department of State"
      ],
      "schema:url": "https://www.pepfar.gov/"
    },
    {
      "@type": [
        "schema:ResearchProject"
      ],
      "schema:alternateName": [
        "DAIDS",
        "The Division of AIDS"
      ],
      "cdifniaid:correctionApproved": false,
      "schema:description": "The Division of AIDS (DAIDS) was formed to develop and implement the national research agenda to address the HIV/AIDS epidemic. Toward that end, the division supports a global research portfolio to advance biological knowledge of HIV/AIDS, its related co-infections, and co-morbidities.  For more information, visit the NIAID program page: https://www.niaid.nih.gov/about/daids\n\nThe Division of AIDS (DAIDS) leads the national HIV/AIDS research agenda, supporting a global portfolio to advance biological knowledge and treatment of HIV/AIDS and related co-infections. The division funds studies to develop new therapies, vaccines, and prevention strategies.",
      "schema:name": "NIAID DAIDS",
      "schema:parentOrganization": [
        "NIAID"
      ],
      "schema:url": "https://www.niaid.nih.gov/about/daids"
    }
  ],
