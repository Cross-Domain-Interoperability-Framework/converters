      "nde:doi": "10.1016/j.neuron.2021.05.003",
      "schema:name": "Resolving cellular and molecular diversity along the hippocampal anterior-to-posterior axis in humans.",
      "schema:url": "https://www.sciencedirect.com/science/article/pii/S0896627321003299?via%3Dihub"
    },
