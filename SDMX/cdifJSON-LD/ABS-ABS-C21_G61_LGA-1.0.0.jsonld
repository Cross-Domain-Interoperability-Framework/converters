        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "SEXP",
      "schema:alternateName": [
        "Sex"
      ],
      "schema:description": "This variable records each person’s sex. A person's sex is based on their sex characteristics, such as their chromosomes, hormones and reproductive organs. If sex is not stated it is imputed. See also Imputation flag for sex ([IFSEXP](https://www.abs.gov.au/census/guide-census-data/census-dictionary/2021/variables-topic/population/imputation-flag-sex-ifsexp)).",
      "schema:propertyID": {
