      "@type": [
        "schema:PropertyValue",
        "cdi:InstanceVariable"
      ],
      "schema:name": "HRSP",
      "schema:alternateName": [
        "Hours worked"
      ],
      "schema:description": "This variable indicates the number of hours worked by the employed person in all jobs during the week prior to Census night. This excludes any time off but includes overtime and extra time worked. In standard Census products the data is generally published in ranges using Hours worked (ranges) [(HRWRP)](https://www.abs.gov.au/census/guide-census-data/census-dictionary/2021/variables-topic/income-and-work/hours-worked-ranges-hrwrp).",
