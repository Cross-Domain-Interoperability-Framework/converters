  "prov:wasGeneratedBy": [
    {
      "@type": [
        "prov:Activity",
        "schema:Action"
      ],
      "@id": "https://sen.science/doi/10.71728/r1rj-f947/method-sections/4bd9f204-fd04-4c4c-9740-b530cdd9667f",
      "schema:name": "Research Design and Approach",
      "schema:description": "The study was designed to monitor and analyze long-term environmental trends in the Basque Country’s marine ecosystems, focusing on water quality, sediment characteristics, and biological communities. The approach involved systematic sampling across multiple sites and taxa groups, employing standardized protocols to ensure data consistency and reliability over the nearly three-decade period. This methodology facilitated the assessment of anthropogenic impacts and the effectiveness of management interventions, providing a comprehensive understanding of ecosystem dynamics in response to both human activities and natural variability.",
      "schema:actionProcess": {
        "@type": [
          "schema:HowTo"
        ],
        "schema:name": "Research Design and Approach",
        "schema:step": [
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 1,
            "schema:name": "Objective and Scope",
            "schema:description": "The primary objective of this study was to assess environmental quality trends in the Basque Country’s marine ecosystems using long-term monitoring data from 1995 to 2023. Key areas of interest include examining water, sediment, and biological components to understand the impact of human pressures, such as industrial and urban discharges, as well as the effectiveness of management actions, like wastewater treatment. This dataset, gathered from 70 sampling stations across the Bay of Biscay, provides insights into environmental changes, supporting the overarching hypothesis that implemented management actions yield positive ecological effects."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 2,
            "schema:name": "Approach Overview",
            "schema:description": "The study utilized an observational monitoring approach, gathering data over nearly three decades to facilitate trend analysis on ecosystem variables affected by anthropogenic and natural factors. Sampling followed standardized protocols for various ecosystems (water, sediment, and biota), as outlined by the Basque Water Agency (URA) and AZTI. Data collection methodologies, including EN 15972:2011 guidelines for water quality sampling, were consistently applied to enable cross-temporal and spatial comparisons. Detailed sampling protocols can be found in the URA resource portal: https://www.uragentzia.euskadi.eus/informacion/protocolos-de-muestreo-de-laboratorio-y-de-calculo-de-indices-y-metricas-para-el-seguimiento-del-estado-de-las-masas-de-agua-superficial-de-la-capv/webura00-01040102seguimiento/es/"
          }
        ]
      },
      "prov:used": [
        {
          "@type": [
            "prov:Entity"
          ],
          "@id": "https://sen.science/doi/10.71728/r1rj-f947/source/readme",
          "schema:name": "Borja 2025 Dataset README",
          "schema:encodingFormat": "text/markdown"
        },
        {
          "@type": [
            "prov:Entity"
          ],
          "@id": "https://sen.science/doi/10.71728/r1rj-f947/source/data_dictionary",
          "schema:name": "Data Dictionary",
          "schema:encodingFormat": "text/csv"
        }
      ]
    },
    {
      "@type": [
        "prov:Activity",
        "schema:Action"
      ],
      "@id": "https://sen.science/doi/10.71728/r1rj-f947/method-sections/005c2a80-a71f-4130-a64a-f36ed85045f2",
      "schema:name": "Instrumentation and Sample Preparation",
      "schema:description": "Equipment used for each component and the handling of samples between collection and laboratory analysis: Niskin bottles and a CTD for water, van Veen grabs and quadrats for sediments and intertidal biota, and beam trawls for demersal fauna, with calibration and preparation following the URA protocols and EN 15972:2011.",
      "schema:actionProcess": {
        "@type": [
          "schema:HowTo"
        ],
        "schema:name": "Instrumentation and Sample Preparation",
        "schema:step": [
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 1,
            "schema:name": "Taxa Group and Sampling Protocols",
            "schema:description": "Sampling methodologies were tailored to each group (taxagroup) to ensure accurate and representative data collection.",
            "schema:itemListElement": [
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Water",
                "schema:text": "Water was sampled every three months, and monthly at a few stations: surface water was collected with a Niskin bottle for nutrients and contaminants, and a CTD was used for temperature, salinity, depth, irradiance, chlorophyll, light transmission, pH and dissolved oxygen."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Sediments",
                "schema:text": "Sediments were sampled annually in winter (January to March), with a 0.1 m2 van Veen grab at coastal stations and a 0.03 m2 grab at the estuarine station E-A10. Each sample was frozen until laboratory analysis."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Biota",
                "schema:text": "Sampling was tailored to each biological group: macroinvertebrates annually in winter, phytoplankton quarterly, macroalgae in spring or early summer every three years, and demersal fish and crustaceans in autumn by beam trawl."
              }
            ]
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 2,
            "schema:name": "Instrumentation and References",
            "schema:description": "Instruments such as van Veen grabs, CTD sensors, and beam trawls were utilized. Calibration and handling followed standardized protocols where available. Key references, including EN 15972:2011 and URA guidelines, were applied to ensure consistency. Detailed protocols are accessible at the URA resource portal: https://www.uragentzia.euskadi.eus/informacion/protocolos-de-muestreo-de-laboratorio-y-de-calculo-de-indices-y-metricas-para-el-seguimiento-del-estado-de-las-masas-de-agua-superficial-de-la-capv/webura00-01040102seguimiento/es/"
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 3,
            "schema:name": "Setup of Tools/Systems",
            "schema:description": "Instrumentation and sampling setups varied by component, adhering to standardized protocols across water, sediment, and biota sampling.",
            "schema:itemListElement": [
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Water Sampling",
                "schema:text": "Surface water was collected with a Niskin bottle and profiled in situ with a CTD, following EN 15972:2011 and the URA sampling protocols."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Sediment Sampling",
                "schema:text": "Subtidal sediments were collected with van Veen grabs (0.1 m2 coastal, 0.03 m2 estuarine); intertidal estuarine stations were sampled with a 0.5 x 0.5 m quadrat to 15 cm depth."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Biota Sampling",
                "schema:text": "Demersal fauna were sampled with beam trawls - 1.5 m wide (10 mm mesh, 8 mm cod end) in the smaller estuaries and 2.5 m wide (40 mm mesh, 14 mm cod end) in the Nerbioi - towed for 10 minutes at 1.5 knots. Macroalgae were sampled along intertidal transects with quadrats, and macroinvertebrate replicates were sieved through a 1 mm mesh."
              }
            ]
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 4,
            "schema:name": "Calibration of Instruments",
            "schema:description": "Calibration applied to the instruments used across the monitoring programme. It is documented in detail for the CTD sensor; calibration records for the van Veen grab and the beam trawl were not available in the source documentation."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 5,
            "schema:name": "CTD Calibration",
            "schema:description": "The CTD sensor used in water sampling underwent regular calibration to ensure accuracy in measurements of dissolved oxygen, temperature, and salinity, following EN 15972:2011 protocols for water quality. Calibration details for sediment and biota equipment, such as the van Veen grab or beam trawl, were not documented in the provided information."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 6,
            "schema:name": "Sample Preparation",
            "schema:description": "Sample preparation varied by component type, based on the specific parameter and storage requirements.",
            "schema:itemListElement": [
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Water Samples",
                "schema:text": "Water collected for nutrient and contaminant determination was handled under the applicable ISO and EN 15972:2011 standards; CTD readings were taken in situ and required no preparation."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Sediment Samples",
                "schema:text": "Sediment samples were frozen on collection and held frozen until laboratory analysis."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Biota Samples",
                "schema:text": "Macroinvertebrate replicates were sieved through a 1 mm mesh and preserved in formaldehyde until identification under a stereomicroscope. Trawled fish and crustaceans were identified onboard and released."
              }
            ]
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 7,
            "schema:name": "Apply and document all additional calibration protocols.",
            "schema:description": "Apply and document all additional calibration protocols."
          }
        ]
      },
