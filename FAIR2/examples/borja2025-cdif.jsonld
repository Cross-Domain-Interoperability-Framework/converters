        }
      ]
    },
    {
      "@type": [
        "prov:Activity",
        "schema:Action"
      ],
      "@id": "https://sen.science/doi/10.71728/r1rj-f947/method-sections/eba6da7c-055a-4ade-8842-c56e0a028a26",
      "schema:name": "Data Processing and Analysis",
      "schema:description": "Consolidation of the raw monitoring records into the published record sets, followed by the statistical analysis used to characterise long-term environmental trends across the monitored variables.",
      "schema:actionProcess": {
        "@type": [
          "schema:HowTo"
        ],
        "schema:name": "Data Processing and Analysis",
        "schema:step": [
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 1,
            "schema:name": "Processing of Data",
            "schema:description": "Data processing involved multiple steps tailored to each component type to ensure consistency and accuracy.",
            "schema:itemListElement": [
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Water Data",
                "schema:text": "Water records were consolidated into the WATER record set, keyed by collection date, station and sample, with every measurement normalised to a parameter, a value and a standard unit."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Sediment and Biota Data",
                "schema:text": "Sediment and biota records were consolidated into their record sets on the same parameter, value and standard-unit model, retaining taxon name and identifier for the biological components."
              }
            ]
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 2,
            "schema:name": "Post-Processing",
            "schema:description": "After initial processing, data underwent additional statistical analyses to assess long-term environmental trends across variables.",
            "schema:itemListElement": [
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Trend Analysis",
                "schema:text": "Long-term trends were derived per variable across the 1995-2023 series, to assess environmental response to human pressures and to management actions such as wastewater treatment."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Software",
                "schema:text": "Trend analysis was carried out in R, with non-parametric confidence intervals computed using the boot package. The descriptive statistics published with each record set were generated with pandas."
              }
            ]
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 3,
            "schema:name": "Analysis Techniques",
            "schema:description": "A range of analytical techniques was used to provide robust time-series analyses across variables.",
            "schema:itemListElement": [
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Seasonal Decomposition",
                "schema:text": "Series were decomposed into seasonal and trend components, so that long-term change could be separated from the marked seasonal cycle of the monitored variables."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Significance Testing",
                "schema:text": "Trend significance was assessed non-parametrically, with bootstrap resampling used to derive confidence intervals for each variable."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Trend Interpretation",
                "schema:text": "Trends were read against the natural variability of each variable, so that improvement attributable to management action could be distinguished from background environmental fluctuation."
              }
            ]
          }
        ]
      }
    },
    {
      "@type": [
        "prov:Activity",
        "schema:Action"
      ],
      "@id": "https://sen.science/doi/10.71728/r1rj-f947/method-sections/3559fdd4-df90-4c25-bb7b-ce3fde9c648c",
      "schema:name": "Quality Assurance and Validation",
      "schema:description": "Measures taken to keep the 28-year series comparable - standardized sampling and analytical protocols and instrument calibration - together with the treatment of variables whose natural variability limits how far an observed trend can be attributed to human pressure.",
      "schema:actionProcess": {
        "@type": [
          "schema:HowTo"
        ],
        "schema:name": "Quality Assurance and Validation",
        "schema:step": [
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 1,
            "schema:name": "Quality Assurance Measures",
            "schema:description": "Standardized sampling and analytical protocols were followed to ensure data consistency and accuracy.",
            "schema:itemListElement": [
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Water Sampling Protocol",
                "schema:text": "Water sampling followed EN 15972:2011 and the URA sampling protocols published on the Basque Water Agency resource portal."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Sediment and Biota Sampling Protocols",
                "schema:text": "Sediment and biota sampling followed the URA protocols for macroinvertebrates, macroalgae and ichthyofauna, applied consistently across stations and years."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Instrument Calibration",
                "schema:text": "Instruments were calibrated to standardized protocols, the CTD regularly for dissolved oxygen, temperature and salinity under EN 15972:2011."
              }
            ]
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 2,
            "schema:name": "Validation Information",
            "schema:description": "Validation rested on cross-validation against independent datasets where these were available; variables without such a reference were carried forward with the qualifications recorded in the following steps."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 3,
            "schema:name": "Interpretation for High-Variability Variables",
            "schema:description": "For variables without cross-validation, trends were interpreted with caution. For example, nutrient levels and sediment composition were analyzed with the understanding that observed changes might reflect natural environmental variability in addition to any anthropogenic influence."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 4,
            "schema:name": "Trend Robustness",
            "schema:description": "To ensure trend reliability, non-parametric confidence intervals were calculated for each variable using the boot package in R. This approach applied bootstrap resampling to verify trend robustness, particularly for variables where natural variability could impact results."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 5,
            "schema:name": "Adjustment for High-Variability Variables",
            "schema:description": "For variables cross-validated with independent datasets, statistical adjustments were applied to account for environmental variability. These adjustments aimed to refine the trend accuracy by minimizing the influence of natural fluctuations, providing a clearer view of anthropogenic effects."
          }
        ]
      }
    },
