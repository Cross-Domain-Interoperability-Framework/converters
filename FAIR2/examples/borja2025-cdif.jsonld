    {
      "@type": [
        "prov:Activity",
        "schema:Action"
      ],
      "@id": "https://sen.science/doi/10.71728/r1rj-f947/method-sections/590e846d-9b12-44c2-a399-deab7b1386ba",
      "schema:name": "Data Collection",
      "schema:description": "Field collection across the 1995-2023 monitoring programme: the sampling schedule for each component, the recording of collection dates, the variables measured in water, sediments and biota, and how observations were logged.",
      "schema:actionProcess": {
        "@type": [
          "schema:HowTo"
        ],
        "schema:name": "Data Collection",
        "schema:step": [
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 1,
            "schema:name": "Sampling Frequency and Timing",
            "schema:description": "Sampling was conducted on the following schedules:\n- **Water**: Quarterly, with some stations sampled at both high and low tides.\n- **Sediments**: Annually, during January.\n- **Phytoplankton** and Macroalgae: Quarterly.\n- **Fish and Invertebrates**: Seasonal, aligned with site accessibility and species-specific behavior."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 2,
            "schema:name": "Temporal Data Logging",
            "schema:description": "Collection dates (datecollected) were systematically recorded for all components to ensure robust temporal analyses."
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 3,
            "schema:name": "Timing and Frequency",
            "schema:description": "Data collection followed a consistent schedule, ensuring reliable comparisons over time.",
            "schema:itemListElement": [
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Water",
                "schema:text": "Quarterly, with some stations sampled at both high and low tides and a few sampled monthly."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Sediments",
                "schema:text": "Annually, in January, within the winter sampling window of January to March."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Biota",
                "schema:text": "Phytoplankton and macroalgae quarterly; fish and invertebrates seasonally, aligned with site accessibility and species-specific behaviour."
              }
            ]
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 4,
            "schema:name": "Variables and Measurements",
            "schema:description": "Explicitly measured variables were selected to provide a comprehensive view of environmental quality across components.",
            "schema:itemListElement": [
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Water Variables",
                "schema:text": "Water measurements are held in the WATER record set as parameter, parameter_value and parameter_standardunit triples, keyed by collection date, station and sample and qualified by sampling depth and effort."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Sediment Variables",
                "schema:text": "Sediment measurements are held in the Sediments record set on the same parameter, parameter_value and parameter_standardunit model, qualified by sampling depth and effort."
              },
              {
                "@type": [
                  "schema:HowToDirection"
                ],
                "schema:name": "Biota Variables",
                "schema:text": "Biological measurements are held in the Biota, Phytoplankton, Macroalgae, Invertebrates and Fish record sets, which add taxaname and taxanameid to the parameter, parameter_value and parameter_standardunit triple."
              }
            ]
          },
          {
            "@type": [
              "schema:HowToStep"
            ],
            "schema:position": 5,
            "schema:name": "Data Logging and Monitoring",
            "schema:description": "Data logging procedures ensured systematic tracking for each component.\n- Real-time logging was applied for immediate on-site measurements like temperature, dissolved oxygen, and pH. For sediment and biota samples, data were logged upon completion of laboratory analysis.\n- The documentation did not specify whether data logging was performed manually or with automated systems. Information on specific data storage software or data logging methods was also not provided."
          }
        ]
      },
      "schema:result": [
